---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Choose a language for Indigenous Taiwan: A Living Atlas."
    />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ja" href="/ja/" />
    <title>Indigenous Taiwan: A Living Atlas</title>
    <script is:inline>
      const preferredLanguage = (
        navigator.languages?.length ? navigator.languages : [navigator.language]
      ).find((language) => /^(en|ja)(-|$)/i.test(language));
      const locale = preferredLanguage?.toLowerCase().startsWith("ja") ? "ja" : "en";

      window.location.replace(`/${locale}/${window.location.search}${window.location.hash}`);
    </script>
  </head>
  <body>
    <main class="language-choice">
      <p>Choose your language / 言語を選択してください</p>
      <nav aria-label="Language selection">
        <a href="/en/" lang="en">English</a>
        <a href="/ja/" lang="ja">日本語</a>
      </nav>
    </main>
  </body>
</html>

<style>
  .language-choice {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }

  .language-choice nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .language-choice a {
    color: inherit;
  }
</style>
